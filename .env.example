# Vercel + Supabase (cross-device prototype)
# Copy to .env for local dev. Set the same names in the Vercel project settings.
#
# Not for PHI/HIPAA — anon RLS allows open read/write of session rows.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GitHub Pages deployment does not use these variables.
# Without them, participant data stays in browser local storage until the researcher downloads JSON files.

# Groq (voice-to-text transcription via Whisper)
# Server-side only — do not prefix with VITE_. Without it, the mic buttons on
# the Tool A / Tool B question fields show a "voice input isn't set up" error.
# Get a key at https://console.groq.com.
GROQ_API_KEY=
